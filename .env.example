# Embedded PostgreSQL (PGlite) storage for local development
PGLITE_DATA_DIR=.data/pglite

# Midtrans (optional). Without these keys the app uses simulated QRIS payments.
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# Set to false to disable one-click demo staff logins.
DEMO_MODE=true
