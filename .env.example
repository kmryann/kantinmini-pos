# Primary public domain (used for canonical URLs, sitemap, robots, and Open Graph)
NEXT_PUBLIC_SITE_URL=https://kantinmini.web.id

# Google Search Console HTML tag verification code (optional)
GOOGLE_SITE_VERIFICATION=

# Embedded PostgreSQL (PGlite) storage for local development
PGLITE_DATA_DIR=/home/your-user/.local/share/kantinmini/pglite

# Order flow (recommended for Vercel: whatsapp)
ORDER_MODE=whatsapp
WHATSAPP_NUMBER=6285117693117

# Static EMVCo merchant QRIS payload string (optional; falls back to built-in Kantin Mini payload)
QRIS_MERCHANT_PAYLOAD=

# Midtrans (optional, for POS mode). Without these keys POS uses simulated QRIS payments.
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_CLIENT_KEY=
MIDTRANS_SERVER_KEY=

# Set to true only in local/demo environments to enable one-click demo staff logins.
DEMO_MODE=false
